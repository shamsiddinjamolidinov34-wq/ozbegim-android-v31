<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:key="open_time_battery"
        app:summary="@string/details_time_battery_summary"
        app:title="@string/details_time_battery" />

    <PreferenceCategory app:title="@string/details_cat_input">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/double_tap_entries"
            app:entryValues="@array/double_tap_values"
            app:key="double_tap_mode"
            app:title="@string/pref_double_tap"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="skip_unlabeled"
            app:summary="@string/pref_skip_unlabeled_summary"
            app:title="@string/pref_skip_unlabeled" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/details_cat_preset">
        <ListPreference
            app:defaultValue="normal"
            app:entries="@array/verbosity_entries"
            app:entryValues="@array/verbosity_values"
            app:key="verbosity"
            app:title="@string/pref_verbosity"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/details_cat_speak">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="det_type_btn"
            app:summary="@string/det_type_btn_summary"
            app:title="@string/det_type_btn" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_type"
            app:summary="@string/det_type_summary"
            app:title="@string/det_type" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="det_position"
            app:summary="@string/det_position_summary"
            app:title="@string/det_position" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="det_hints"
            app:summary="@string/det_hints_summary"
            app:title="@string/det_hints" />
        <ListPreference
            app:defaultValue="name_type_state"
            app:entries="@array/det_order_entries"
            app:entryValues="@array/det_order_values"
            app:key="det_order"
            app:title="@string/det_order"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_window_titles"
            app:summary="@string/det_window_titles_summary"
            app:title="@string/det_window_titles" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_screen_off"
            app:summary="@string/det_screen_off_summary"
            app:title="@string/det_screen_off" />
        <ListPreference
            app:defaultValue="chars"
            app:entries="@array/echo_entries"
            app:entryValues="@array/echo_values"
            app:key="echo_mode"
            app:title="@string/pref_echo_mode"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/details_cat_prosody">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="det_prosody"
            app:summary="@string/det_prosody_summary"
            app:title="@string/det_prosody" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/details_cat_language">
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/det_lang_entries"
            app:entryValues="@array/det_lang_values"
            app:key="det_lang"
            app:title="@string/det_lang"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="det_lang_about"
            app:selectable="false"
            app:summary="@string/det_lang_summary"
            app:title="@string/det_lang_about" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/details_cat_emoji">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_emoji"
            app:summary="@string/det_emoji_summary"
            app:title="@string/det_emoji" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_stickers"
            app:summary="@string/det_stickers_summary"
            app:title="@string/det_stickers" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="det_sticker_short"
            app:summary="@string/det_sticker_short_summary"
            app:title="@string/det_sticker_short" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/details_cat_numbers">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_phone"
            app:summary="@string/det_phone_summary"
            app:title="@string/det_phone" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/details_cat_science">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_sci_units"
            app:summary="@string/det_sci_units_summary"
            app:title="@string/det_sci_units" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_sci_physics"
            app:summary="@string/det_sci_physics_summary"
            app:title="@string/det_sci_physics" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_sci_math"
            app:summary="@string/det_sci_math_summary"
            app:title="@string/det_sci_math" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_sci_info"
            app:summary="@string/det_sci_info_summary"
            app:title="@string/det_sci_info" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/details_cat_volume">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="det_volume_keep"
            app:summary="@string/det_volume_keep_summary"
            app:title="@string/det_volume_keep" />
    </PreferenceCategory>
</PreferenceScreen>
