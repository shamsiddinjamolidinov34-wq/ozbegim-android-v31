<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Faqat ixtiyoriy onlayn imkoniyatlar (Microsoft ovozi, tarjima, AI) uchun. Sozlamalarda "Onlayn imkoniyatlarni
         yoqish" o'chiq bo'lsa, tarmoqqa hech narsa yuborilmaydi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Vaqt e'loni: ekran o'chiq paytida ham o'z vaqtida aytilishi uchun (aniq alarm va qisqa uyg'oq turish) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+: aniq alarm ruxsati o'rnatishda o'zi beriladi (Sozlamalarda qo'lda yoqish shart emas): yarim soatlik e'lon
         ekran o'chiq paytida ham aniq vaqtda aytiladi. Ilovani Google Play'ga qo'yish rejalashtirilsa, bu ruxsatni qayta ko'rib chiqing. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Ixtiyoriy: kompyuterdan bir marta berilsa (adb shell pm grant uz.ekranoquvchi.mvp android.permission.WRITE_SECURE_SETTINGS),
         "O'zbegimni afzal ko'rilgan mexanizm qilish" tugmasi tizim sozlamalarini ochmasdan, bir zumda ishlaydi. Berilmasa,
         ekran o'quvchi xizmati sozlamalarni o'zi bosadi. Oddiy o'rnatishda bu ruxsat berilmaydi. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+: boshqa TTS dvigatellarini (masalan, RHVoice) ko'rish va ularga ulanish uchun -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Bosh ekran ilovasini (launcher) aniqlash: ikki barmoq bilan surish bosh ekranda ilovalar menyusini ochadi -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- RHVoice: o'zbek ovozlari (Islom, Dilnavoz, Sevinch) uchun; o'rnatilganini bilish va ochish -->
        <package android:name="com.github.olga_yakovleva.rhvoice.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reader">

        <!-- directBootAware: qurilma qayta yoqilgandan keyin, qulf ochilmasdan (PIN ekranida) ham gapiradi -->
        <service
            android:name=".ReaderService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.HealthActivity" android:exported="false" />
        <activity android:name=".ui.LogActivity" android:exported="false" />
        <activity android:name=".ui.VoicesActivity" android:exported="false" />
        <activity android:name=".ui.AiSettingsActivity" android:exported="false" />
        <activity android:name=".ui.DetailsActivity" android:exported="false" />
        <activity android:name=".ui.TimeBatteryActivity" android:exported="false" />
        <receiver android:name=".core.TimeAlarmReceiver" android:exported="false" />
        <activity android:name=".ui.GesturesActivity" android:exported="false" />
        <activity android:name=".ui.MenuActivity" android:exported="false" />
        <activity android:name=".ui.TutorialActivity" android:exported="false" />
        <activity
            android:name=".ui.ScreenSearchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Reader.Dialog" />
        <activity android:name=".ui.BackupActivity" android:exported="false" />
        <activity android:name=".ui.ContactActivity" android:exported="false" />
        <activity android:name=".ui.TextFileEditorActivity" android:exported="false" />

        <!-- Tizim nutq dvigateli: Android sozlamalarida "Afzal ko'rilgan mexanizm" ro'yxatida O'zbegim chiqadi.
             Ovozni telefondagi boshqa dvigatel beradi; O'zbegim matnni o'z qoidalari bilan tayyorlaydi (tts/OzbegimTtsService). -->
        <service
            android:name=".tts.OzbegimTtsService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/tts_engine_label">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>
        <activity
            android:name=".tts.CheckVoiceDataActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".tts.GetSampleTextActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Dvigatel sozlamalari: tizim sozlamalaridagi dvigatel yonidagi tugma shuni ochadi (res/xml/tts_engine.xml) -->
        <activity
            android:name=".ui.TtsEngineActivity"
            android:exported="true"
            android:label="@string/tts_engine_settings_title" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
